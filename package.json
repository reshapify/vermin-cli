{
  "name": "@vermin/cli",
  "version": "0.1.0",
  "description": "The Vermin command line: turn any website into clean, LLM-ready markdown and brand data from your terminal or agent.",
  "license": "MIT",
  "homepage": "https://vermin.dev/docs/cli",
  "repository": { "type": "git", "url": "git+https://github.com/reshapify/vermin-cli.git" },
  "bugs": { "url": "https://github.com/reshapify/vermin-cli/issues" },
  "keywords": ["vermin", "cli", "scrape", "crawl", "markdown", "llm", "ai", "agents", "web-data"],
  "type": "module",
  "bin": { "vermin": "./dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18.3" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@vermin/sdk": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": { "access": "public", "provenance": true }
}
